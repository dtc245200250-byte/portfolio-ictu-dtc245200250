HTTP_PORT=8080
HTTPS_PORT=8443

# Database & Administration Tool
PHPMYADMIN_PORT=8088

# Giám sát & Quản lý Log
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL ---
